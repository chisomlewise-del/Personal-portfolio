---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Picture shown when the page is shared on LinkedIn, WhatsApp, X… (in /public) */
  image?: string;
}

const {
  title = "Chisom Lewise — Product Designer",
  description = "A Product Designer building purposeful digital experiences for people and businesses.",
  image = "/og-image.jpg",
} = Astro.props;

// Full web addresses (share previews need complete links, not just "/about")
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#f5f5f5" />

    <!-- Browser tab + phone home-screen icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Link preview card (LinkedIn, WhatsApp, Slack, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chisom Lewise" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chisom Lewise — Product Designer. Available for work." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Turn on scroll-reveal animations early (prevents a flash). Skipped for reduced motion,
         so content is always visible if JavaScript or animations are off. -->
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </head>
  <body id="top">
    <slot />

    <script>
      // Scroll-reveal: anything with data-reveal fades/rises in when it scrolls into view.
      // Every item in a case study (.case-flow) gets it automatically.
      if (document.documentElement.classList.contains("reveal-ready")) {
        document.querySelectorAll<HTMLElement>(".case-flow > *").forEach((el) => {
          if (el.hasAttribute("data-reveal")) return;
          el.dataset.reveal = el.matches("img, picture") ? "zoom" : "up";
        });

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
