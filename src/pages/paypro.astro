---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CaseHeader from "../components/case-study/CaseHeader.astro";
import TextBlock from "../components/case-study/TextBlock.astro";

import macbook from "../assets/paypro/macbook.png";
import dashboard from "../assets/paypro/dashboard.png";
import employees from "../assets/paypro/employees.png";
import payrun from "../assets/paypro/payrun.png";

const meta = [
  { label: "ROLE", value: "Product Designer" },
  { label: "TIMELINE", value: "2 Weeks" },
  { label: "YEAR", value: "2026" },
];

// Each screen: a short write-up followed by the screen itself
const screens = [
  {
    title: "Dashboard",
    text: "The dashboard provides a quick overview of payroll operations by showing total number of employees, the monthly payroll amount, the next payroll date, pending approvals, a payroll summary chart with salary breakdown, and a payrun list with announcements and reminders such as tax filings and pension contribution",
    image: dashboard,
    alt: "PayPro dashboard",
  },
  {
    title: "Employee Management",
    text: "The employee management screen helps users manage employee payroll information by displaying total, active and inactive employee counts, providing search and filter option and presenting a structured employee list with key details like role, employee type, salary and current status",
    image: employees,
    alt: "PayPro employee management screen",
  },
  {
    title: "Payrun (Payroll management)",
    text: "The payrun screen allows users to monitor payroll activities by summarizing key payroll metrics such as total employees, total net salary, and total deductions, while also displaying a detailed payroll activity table showing each employee’s deduction, net salary, and payment status, with options to filter date and export payroll records",
    image: payrun,
    alt: "PayPro payrun screen",
  },
];

const wideSizes = "(min-width: 1440px) 1312px, 92vw";
const wideWidths = [800, 1312, 1800, 2624];
---

<Layout
  title="PayPro Payroll Web App — Case Study | Chisom Lewise"
  description="PayPro case study by Chisom Lewise: a payroll web app that helps HR teams and business owners manage employees and run payroll clearly and efficiently."
>
  <Nav />

  <main class="mx-auto max-w-[1440px] px-5 pt-10 text-ink md:px-10 md:pt-[65px] xl:px-16">
    <CaseHeader title="PayPro" subtitle="Modern Payroll Web Application" meta={meta} />

    <div class="case-flow mt-14 md:mt-24">
      <section class="flex flex-col gap-3">
        <h2 class="text-[24px] leading-[32px] font-medium tracking-[-0.165px] md:text-[28px] md:leading-[36px]">Project Overview</h2>
        <div class="copy text-[16px] leading-[26px] tracking-[0.027px] text-nav md:text-[18px] md:leading-[28px]">
          <p>
            Paypro is a modern payroll web application designed to help HR teams and Business owners manage employee records and run payroll in a <strong class="font-semibold">clear</strong>, <strong class="font-semibold">structured</strong> and <strong class="font-semibold">efficient way.</strong>
          </p>
          <p>Payroll tools are often overwhelming due to heavy data tables, unclear workflows and poor information hierarchy. With PayPro, my goal was to simplify payroll management by designing an experience that feels clean, intuitive and easy to navigate.</p>
        </div>
      </section>

      <Image
        src={macbook}
        alt="The PayPro dashboard on a MacBook Air"
        widths={[800, 1312]}
        sizes={wideSizes}
        class="aspect-[1312/823] w-full rounded-[20px] object-cover md:rounded-[30px]"
        loading="eager"
      />

      {screens.map((screen) => (
        <>
          <TextBlock class="section-start" title={screen.title} paragraphs={[screen.text]} />
          <Image
            src={screen.image}
            alt={screen.alt}
            widths={wideWidths}
            sizes={wideSizes}
            class="h-auto w-full"
          />
        </>
      ))}
    </div>
  </main>

  <div class="mt-4 md:mt-12">
    <Footer />
  </div>
</Layout>
